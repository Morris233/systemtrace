<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SystemTrace.App.ViewModels" xmlns:views="clr-namespace:SystemTrace.App.Views" x:Class="SystemTrace.App.MainWindow" Title="{DynamicResource AppName}" Width="1180" Height="780" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Language="{Binding DisplayLanguage}">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewPageViewModel}">
      <views:OverviewView DataContext="{Binding Model}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TimelinePageViewModel}">
      <views:TimelineView DataContext="{Binding Model}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SnapshotsPageViewModel}">
      <views:SnapshotsView DataContext="{Binding Model}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TroubleshootPageViewModel}">
      <views:TroubleshootView DataContext="{Binding Model}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
      <views:SettingsView DataContext="{Binding Model}"/>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,28,18,24">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource AppName}" FontSize="21" FontWeight="SemiBold" Margin="6,0,0,34"/>
        <ListBox SelectedIndex="{Binding SelectedPageIndex,Mode=TwoWay}" Style="{StaticResource NavigationList}" AutomationProperties.Name="{DynamicResource Navigation}" VerticalAlignment="Top">
          <ListBoxItem AutomationProperties.Name="{DynamicResource Overview}">
            <TextBlock Text="{DynamicResource Overview}"/>
          </ListBoxItem>
          <ListBoxItem AutomationProperties.Name="{DynamicResource Timeline}">
            <TextBlock Text="{DynamicResource Timeline}"/>
          </ListBoxItem>
          <ListBoxItem AutomationProperties.Name="{DynamicResource Snapshots}">
            <TextBlock Text="{DynamicResource Snapshots}"/>
          </ListBoxItem>
          <ListBoxItem AutomationProperties.Name="{DynamicResource Troubleshoot}">
            <TextBlock Text="{DynamicResource Troubleshoot}"/>
          </ListBoxItem>
          <ListBoxItem AutomationProperties.Name="{DynamicResource Settings}">
            <TextBlock Text="{DynamicResource Settings}"/>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="True" Margin="0,0,0,20">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource IdlePanel}">
          <Button Content="{DynamicResource LanguageToggle}" Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource ThemeToggle}" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource ScanNow}" Command="{Binding ScanCommand}" Background="{DynamicResource AccentSoftBrush}"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource LocalNotice}" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,12,0"/>
      </DockPanel>
      <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,12" Style="{StaticResource BusyProgress}" Foreground="{DynamicResource AccentBrush}"/>
      <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
      <ContentControl Grid.Row="3" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
  </Grid>
</Window>
