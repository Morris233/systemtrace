<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SystemTrace.App.Views" x:Class="SystemTrace.App.Views.TroubleshootView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource Troubleshoot}" Style="{StaticResource PageTitle}"/>
    <StackPanel Grid.Row="1" Style="{StaticResource IdlePanel}">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="108"/>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <DatePicker SelectedDate="{Binding IncidentDate}" AutomationProperties.Name="{DynamicResource IncidentDate}"/>
        <TextBox Grid.Column="1" Text="{Binding IncidentTime,UpdateSourceTrigger=PropertyChanged}" ToolTip="HH:mm:ss" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource IncidentTime}"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding SelectedWindow}" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource LookbackWindow}"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding TroubleCategory}" Margin="8,0" AutomationProperties.Name="{DynamicResource Category}"/>
        <Button Grid.Column="4" Content="{DynamicResource Search}" Command="{Binding SearchTroubleCommand}"/>
      </Grid>
      <TextBox Text="{Binding TroubleText,UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource SearchHint}" MaxLength="512" AutomationProperties.Name="{DynamicResource Search}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchTroubleCommand}"/>
        </TextBox.InputBindings>
      </TextBox>
      <TextBlock Text="{DynamicResource TroubleshootCaution}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding TroubleRows}" SelectedItem="{Binding SelectedTroubleRow,Mode=TwoWay}" Style="{StaticResource ChangeList}" AutomationProperties.Name="{DynamicResource ChangeRecords}"/>
      <views:ChangeDetailView Grid.Column="2" DataContext="{Binding TroubleDetail}"/>
    </Grid>
    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{DynamicResource Previous}" Command="{Binding PreviousTroubleCommand}"/>
        <TextBlock Text="{Binding TroublePageText}" VerticalAlignment="Center" Margin="12,0"/>
        <Button Content="{DynamicResource Next}" Command="{Binding NextTroubleCommand}"/>
      </StackPanel>
      <TextBlock Text="{Binding TroubleCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Grid.Row="2" Text="{DynamicResource NoMatches}" Style="{StaticResource EmptyTrouble}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,28,0,0"/>
  </Grid>
</UserControl>
