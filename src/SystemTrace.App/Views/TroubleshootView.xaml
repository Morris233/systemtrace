<UserControl x:Class="SystemTrace.App.Views.TroubleshootView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{DynamicResource TroubleshootTitle}" Style="{StaticResource PageTitle}" />
    <Border Style="{StaticResource Card}" Padding="32,46"><StackPanel>
      <TextBlock Text="{DynamicResource TroubleshootEmpty}" FontSize="23" TextWrapping="Wrap" Margin="0,0,0,18" />
      <TextBlock Text="{DynamicResource TroubleshootBody}" Style="{StaticResource MutedText}" Margin="0,0,0,28" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
