<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SystemTrace.App.Views.ChangeDetailView">
  <Border Style="{StaticResource Card}" Padding="16">
    <Grid>
      <TextBlock Text="{DynamicResource SelectChange}" Style="{StaticResource EmptyDetail}" TextWrapping="Wrap" VerticalAlignment="Top"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PresentDetail}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,12"/>
          <TextBlock Text="{DynamicResource ObservedWindow}" Style="{StaticResource MutedText}" FontSize="12"/>
          <TextBlock Text="{Binding Window}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,18"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Field}" Style="{StaticResource MutedText}"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource Before}" Style="{StaticResource MutedText}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource After}" Style="{StaticResource MutedText}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,6,8,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Changed}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBox Grid.Column="1" Text="{Binding Before,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0" ToolTip="{Binding BeforeError}"/>
                  <TextBox Grid.Column="2" Text="{Binding After,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" ToolTip="{Binding AfterError}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="{DynamicResource SourceIdentity}" Margin="0,10,0,0">
            <TextBox Text="{Binding Identity,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
