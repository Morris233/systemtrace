<UserControl x:Class="SystemTrace.App.Views.SnapshotsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{DynamicResource SnapshotsTitle}" Style="{StaticResource PageTitle}" />
    <UniformGrid Columns="2" Margin="-6,0,-6,24">
      <Border Style="{StaticResource Card}" Margin="6"><StackPanel>
        <TextBlock Text="{DynamicResource SampleA}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{DynamicResource SnapshotPlaceholder}" Style="{StaticResource MutedText}" Margin="0,18,0,18" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6"><StackPanel>
        <TextBlock Text="{DynamicResource SampleB}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{DynamicResource SnapshotPlaceholder}" Style="{StaticResource MutedText}" Margin="0,18,0,18" />
      </StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="{DynamicResource CompareUnavailable}" Style="{StaticResource MutedText}" />
  </StackPanel>
</UserControl>
