<UserControl x:Class="SystemTrace.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitle}" />
    <TextBlock Text="{DynamicResource SettingsSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,28" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="{DynamicResource AppearanceTitle}" Style="{StaticResource SectionTitle}" />
      <DockPanel Margin="0,8,0,18">
        <Button DockPanel.Dock="Right" Content="{DynamicResource LanguageToggle}" Command="{Binding DataContext.ToggleLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="18,0,0,0" AutomationProperties.Name="{DynamicResource LanguageToggle}" />
        <TextBlock Text="{DynamicResource LanguageDescription}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource ThemeToggle}" Command="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="18,0,0,0" AutomationProperties.Name="{DynamicResource ThemeToggle}" />
        <TextBlock Text="{DynamicResource ThemeDescription}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="{DynamicResource BackgroundTitle}" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{DynamicResource BackgroundBody}" Style="{StaticResource MutedText}" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
