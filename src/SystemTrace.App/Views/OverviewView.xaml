<UserControl x:Class="SystemTrace.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{DynamicResource OverviewTitle}" Style="{StaticResource PageTitle}" />
    <TextBlock Text="{DynamicResource ScopeTitle}" Style="{StaticResource SectionTitle}" />
    <UniformGrid Columns="2" Margin="-6,0,-6,24">
      <Border Style="{StaticResource Card}" Padding="18" Margin="6"><StackPanel>
        <TextBlock Text="{DynamicResource Software}" Style="{StaticResource MutedText}" />
        <TextBlock Text="{Binding Overview.Categories[0].ExampleCount}" FontSize="30" Margin="0,4,0,0" />
        <TextBlock Text="{Binding CountCaption}" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBlock Text="{Binding Results[0].StatusText}" ToolTip="{Binding Results[0].WarningText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="6"><StackPanel>
        <TextBlock Text="{DynamicResource Startup}" Style="{StaticResource MutedText}" />
        <TextBlock Text="{Binding Overview.Categories[1].ExampleCount}" FontSize="30" Margin="0,4,0,0" />
        <TextBlock Text="{Binding CountCaption}" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBlock Text="{Binding Results[1].StatusText}" ToolTip="{Binding Results[1].WarningText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="6"><StackPanel>
        <TextBlock Text="{DynamicResource Drivers}" Style="{StaticResource MutedText}" />
        <TextBlock Text="{Binding Overview.Categories[2].ExampleCount}" FontSize="30" Margin="0,4,0,0" />
        <TextBlock Text="{Binding CountCaption}" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBlock Text="{Binding Results[2].StatusText}" ToolTip="{Binding Results[2].WarningText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="6"><StackPanel>
        <TextBlock Text="{DynamicResource Network}" Style="{StaticResource MutedText}" />
        <TextBlock Text="{Binding Overview.Categories[3].ExampleCount}" FontSize="30" Margin="0,4,0,0" />
        <TextBlock Text="{Binding CountCaption}" Style="{StaticResource MutedText}" FontSize="12" />
        <TextBlock Text="{Binding Results[3].StatusText}" ToolTip="{Binding Results[3].WarningText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Card}"><DockPanel>
      <Button DockPanel.Dock="Right" Content="{Binding DataContext.ScanButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="{Binding DataContext.ScanButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
      <StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" />
      </StackPanel>
    </DockPanel></Border>
    <TextBlock Text="{Binding DataContext.ErrorMessage, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="{DynamicResource DemoTextBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
