<UserControl x:Class="SystemTrace.App.Views.TimelineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{DynamicResource TimelineTitle}" Style="{StaticResource PageTitle}" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="{DynamicResource ExampleUpdate}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />
      <TextBlock Text="{DynamicResource SampleEditor}" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="1.0 → 1.1" Style="{StaticResource MutedText}" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24"><StackPanel>
      <TextBlock Text="{DynamicResource ExampleAdapter}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />
      <TextBlock Text="{DynamicResource SampleAdapter}" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{DynamicResource SampleState}" Style="{StaticResource MutedText}" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
