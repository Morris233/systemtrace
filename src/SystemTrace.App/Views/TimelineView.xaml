<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SystemTrace.App.Views" x:Class="SystemTrace.App.Views.TimelineView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{DynamicResource ExportHint}">
        <CheckBox Content="{DynamicResource RedactExports}" IsChecked="{Binding RedactExports}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Content="{DynamicResource ExportJson}" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource ExportCsv}" Command="{Binding ExportCsvCommand}"/>
      </StackPanel>
      <TextBlock Text="{DynamicResource Timeline}" FontSize="26" FontWeight="SemiBold"/>
    </DockPanel>
    <Grid Grid.Row="1" Style="{StaticResource IdleGrid}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="140"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource SearchHint}" MaxLength="512" AutomationProperties.Name="{DynamicResource Search}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
        </TextBox.InputBindings>
      </TextBox>
      <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding TimelineCategory}" Margin="8,0" AutomationProperties.Name="{DynamicResource Category}"/>
      <ComboBox Grid.Column="2" ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedItem="{Binding TimelineKind}" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource ChangeType}" ToolTip="{DynamicResource KindHint}"/>
      <Button Grid.Column="3" Content="{DynamicResource Search}" Command="{Binding SearchCommand}"/>
      <Button Grid.Column="4" Content="{DynamicResource ResetFilters}" Command="{Binding ResetTimelineCommand}" Margin="8,0,0,0"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding TimelineRows}" SelectedItem="{Binding SelectedTimelineRow,Mode=TwoWay}" Style="{StaticResource ChangeList}" AutomationProperties.Name="{DynamicResource ChangeRecords}"/>
      <views:ChangeDetailView Grid.Column="2" DataContext="{Binding TimelineDetail}"/>
    </Grid>
    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{DynamicResource Previous}" Command="{Binding PreviousTimelineCommand}"/>
        <TextBlock Text="{Binding TimelinePageText}" VerticalAlignment="Center" Margin="12,0"/>
        <Button Content="{DynamicResource Next}" Command="{Binding NextTimelineCommand}"/>
      </StackPanel>
      <TextBlock Text="{Binding TimelineCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Grid.Row="2" Text="{Binding TimelineStateText}" Style="{StaticResource EmptyTimeline}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,28,0,0"/>
  </Grid>
</UserControl>
