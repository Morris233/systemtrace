<UserControl x:Class="SystemTrace.App.Views.TimelineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{DynamicResource TimelineTitle}" Style="{StaticResource PageTitle}" />
    <TextBlock Text="{DynamicResource NoChanges}" Style="{StaticResource EmptyRows}" />
    <TextBlock Text="{DynamicResource ObservedWindow}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Foreground="{DynamicResource AccentBrush}" Margin="16,0,0,0" />
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="{Binding ValueText}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding ObservationWindow}" Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
